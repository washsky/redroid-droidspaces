# Copy to ignored lab.env, then source it on the workstation.
export HOST_ADB='REPLACE_HOST_USB_SERIAL'
export INNER_ADB='127.0.0.1:15613'
export CONTAINER_NAME='redroid13arm'
export DROIDSPACES='/data/local/Droidspaces/bin/droidspaces'
export AOSP_ROOT='/opt/android-lab/aosp13-r82'
export NDK_ROOT='/opt/android/android-ndk-r29'
export ANDROID_SDK_ROOT='/opt/android/sdk'
export SCRCPY_SRC='/opt/android-lab/scrcpy'
# Needed for custom scrcpy server: platform API 36 android.jar + framework.aidl
export SDK_PLATFORM_DIR='/opt/android/sdk/platforms/android-36'
# AOSP public test keys are lab-only; for your own APK choose your own key.
export SIGN_CERT='/opt/android-lab/test-signing/test.x509.pem'
export SIGN_KEY='/opt/android-lab/test-signing/test.pk8'
