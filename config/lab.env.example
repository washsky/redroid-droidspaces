# Copy to ignored lab.env. Downloading the Release needs none of these.
# Verify these targets on site. All adb commands must include -s.
export HOST_ADB=REPLACE_PHYSICAL_ADB_SERIAL
export INNER_ADB=127.0.0.1:15615
export CONTAINER_NAME=redroid13release
export DROIDSPACES=/data/local/Droidspaces/bin/droidspaces
export NDK_ROOT=/path/to/android-ndk-r29
export ANDROID_BUILD_TOOLS=/path/to/android-sdk/build-tools/36.0.0
export ANDROID_JAR=/path/to/android-sdk/platforms/android-36/android.jar
export SIGN_CERT=/path/to/your/signing-certificate.x509.pem
export SIGN_KEY=/path/to/your/signing-key.pk8
# Optional large source trees, needed only for their corresponding builds:
export AOSP_ROOT=/path/to/aosp13-r82
export MESA_ROOT=/path/to/mesa-for-android-container
# Historical custom-server build only; the released image uses stock scrcpy.
export ANDROID_SDK_ROOT=/path/to/android-sdk
export SDK_PLATFORM_DIR=/path/to/android-sdk/platforms/android-36
export SCRCPY_SRC=/path/to/scrcpy
