+package com.genymobile.scrcpy.video;
+import android.os.Build;
+import android.view.Surface;
+import com.genymobile.scrcpy.util.Ln;
+import java.io.File;
+import java.io.IOException;
+/** Android 13 lab integration: keep the encoder's GPU-rendered input linear. */
+public final class LinearEncoderSupport {
+ private static boolean loaded;
+ private static volatile boolean active;
+ private static native int forceLinear(Surface surface);
+ public static boolean isActive(){return active;}
+ public static void attach(Surface surface,String codec)throws IOException {
+  active=Build.VERSION.SDK_INT==33 && codec!=null && codec.startsWith("c2.qti.")
+    && new File("/data/local/tmp/arm13-linear-recording.enabled").isFile();
+  if(!active)return;
+  try {
+   if(!loaded){System.load("/data/local/tmp/libarm13_linear_window.so");loaded=true;}
+   int r=forceLinear(surface);if(r!=0)throw new IOException("Linear encoder Surface setup failed: "+r);
+   Ln.i("ARM13: linear GPU Surface enabled for "+codec);
+  }catch(UnsatisfiedLinkError e){throw new IOException("ARM13 linear Surface helper unavailable",e);}
+ }
+}
