-// Relabel directory
+// Read the real label rather than the synthetic label returned by the ReDroid libselinux shim.
+static constexpr char kSelinuxLabelXattr[] = "security.selinux";
+
+static ssize_t readAppDataLabel(const char* path, char** context) {
+  const ssize_t size = getxattr(path, kSelinuxLabelXattr, nullptr, 0);
+  if (size <= 0) {
+    if (size == 0) errno = ENODATA;
+    return -1;
+  }
+  char* label = static_cast<char*>(calloc(size + 1, 1));
+  if (!label) return -1;
+  const ssize_t result = getxattr(path, kSelinuxLabelXattr, label, size);
+  if (result <= 0) {
+    const int error = result == 0 ? ENODATA : errno;
+    free(label);
+    errno = error;
+    return -1;
+  }
+  *context = label;
+  return result;
+}
+
+// Preserve the kernel labels when recreating app data mount points.
 static void relabelDir(const char* path, const char* context, fail_fn_t fail_fn) {
-  if (setfilecon(path, context) != 0) {
+  if (setxattr(path, kSelinuxLabelXattr, context, strlen(context) + 1, 0) != 0) {
     fail_fn(CREATE_ERROR("Failed to setfilecon %s %s", path, strerror(errno)));
   }
 }
